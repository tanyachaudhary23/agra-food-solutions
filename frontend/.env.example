# Address of the deployed BACKEND API (no trailing slash). Local: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Address of THIS website (used for canonical links, sitemap, social previews). Production: https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: private address the website server uses to reach the backend (e.g. inside Docker). Defaults to NEXT_PUBLIC_API_URL
# API_INTERNAL_URL=

# Optional spam protection for the enquiry form: Cloudflare Turnstile SITE key (the secret key goes in the backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional privacy-friendly analytics (Plausible). Loaded only after the visitor accepts the consent banner
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
