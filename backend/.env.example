# ---------- Server ----------
PORT=4000
# Public address of THIS backend (used to build image links). In production: https://api.yourdomain.com
PUBLIC_BASE_URL=http://localhost:4000
# Website address(es) allowed to call this API, comma separated. In production list both, e.g.
# https://www.yourdomain.com,https://yourdomain.com
FRONTEND_URL=http://localhost:3000
# Folder for the database and uploaded files (default: ./data). In production this MUST be persistent storage
# (a disk/volume). On Docker leave this commented out: the image already stores everything in /data.
# DATA_DIR=./data
# Required in production: a long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET=
# Set to 1 when running behind a proxy/host such as Render, Railway or nginx (default: 1 in production)
# TRUST_PROXY=1

# ---------- First admin account (created automatically on first start) ----------
# Password must be at least 10 characters. You can delete ADMIN_PASSWORD from this file afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Enquiry email (optional: enquiries are always saved and shown in the admin panel) ----------
# Gmail example: smtp.gmail.com / 587 / the Gmail address / a 16-character App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender must be the mailbox you log in with (or an address your provider lets you send as)
ENQUIRY_FROM_EMAIL=
# Fallback inbox; you can change the inbox later in Admin > Settings without redeploying
ENQUIRY_TO_EMAIL=

# ---------- Spam protection (optional, recommended): Cloudflare Turnstile secret key ----------
TURNSTILE_SECRET_KEY=
